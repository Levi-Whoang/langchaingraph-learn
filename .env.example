# 复制这个文件为 .env，填上自己的 key 就能用真模型。
# .env 不要提交到 git（已经写进 .gitignore）。

# ---------------------------------------------------------------------------
# 用哪一家？选一个填，然后把 LC_PROVIDER 改成对应名字
# 可选：deepseek / openai / dashscope / moonshot / offline
# ---------------------------------------------------------------------------
LC_PROVIDER=deepseek

# DeepSeek（最便宜，中文好，推荐先用这个）
DEEPSEEK_API_KEY=

# 通义千问 DashScope
# DASHSCOPE_API_KEY=

# 月之暗面 Kimi
# MOONSHOT_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 模型名，不填就用该平台的默认值
#   deepseek  → deepseek-chat / deepseek-reasoner
#   dashscope → qwen-plus / qwen-max
# ---------------------------------------------------------------------------
LC_MODEL=deepseek-chat
